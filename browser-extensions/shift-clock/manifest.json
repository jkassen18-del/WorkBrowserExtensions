{
  "manifest_version": 3,
  "name": "Shift Clock",
  "version": "1.0.0",
  "description": "Clock in, log breaks and smoke breaks, clock out. Tracks your 9-hour shifts against the monthly target, tells you when it's almost time to go home and keeps your standby rota. Stored on this device.",
  "wx": { "glyph": "clock" },
  "permissions": ["storage", "unlimitedStorage", "alarms", "idle", "notifications"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "action": { "default_popup": "popup/popup.html", "default_title": "{name}" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+K" }, "description": "Open Shift Clock" }
  }
}
