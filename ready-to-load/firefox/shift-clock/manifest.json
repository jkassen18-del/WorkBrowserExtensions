{
  "manifest_version": 3,
  "name": "Acme Shift Clock",
  "version": "1.0.0",
  "description": "Clock in, log breaks and smoke breaks, clock out. Tracks your 9-hour shifts against the monthly target, tells you when it's almost time to go home and keeps your standby rota. Stored on this device.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "idle",
    "notifications"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "type": "module",
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Acme Shift Clock",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Open Shift Clock"
    }
  },
  "short_name": "Shift Clock",
  "author": "Acme Inc.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "shift-clock@acme.example",
      "strict_min_version": "128.0"
    }
  }
}