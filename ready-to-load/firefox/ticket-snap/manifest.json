{
  "manifest_version": 3,
  "name": "Acme Ticket Snap",
  "version": "1.0.0",
  "description": "Screenshot a tab, mark it up and turn it into a support ticket with diagnostics attached. Works with no setup for Acme Inc.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "type": "module",
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Acme Ticket Snap: report a problem",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "commands": {
    "capture-tab": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Capture this tab and start a ticket"
    }
  },
  "short_name": "Ticket Snap",
  "author": "Acme Inc.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ticket-snap@acme.example",
      "strict_min_version": "128.0"
    }
  }
}