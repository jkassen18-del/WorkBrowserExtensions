{
  "manifest_version": 3,
  "name": "Acme SaaS Usage Reporter",
  "short_name": "SaaS Usage",
  "version": "1.0.0",
  "description": "See which SaaS apps you use and for how long, spot unused licences and unapproved tools. Stored on this device; domains only.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "tabs",
    "idle",
    "alarms"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "type": "module",
    "scripts": [
      "background.js"
    ]
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Acme SaaS Usage Reporter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "author": "Acme Inc.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "saas-reporter@acme.example",
      "strict_min_version": "128.0"
    }
  }
}